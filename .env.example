# 服务端监听端口
PORT=3001

# 汇率内存缓存时长（毫秒），默认 5 分钟
CACHE_TTL_MS=300000

# 汇率走势（时间序列）缓存时长（毫秒），默认 1 小时
HISTORY_CACHE_TTL_MS=3600000

# 上游请求超时（毫秒）
UPSTREAM_TIMEOUT_MS=8000

# 上游数据源地址（默认 Frankfurter，无需 API Key）
UPSTREAM_BASE_URL=https://api.frankfurter.app

# 当前数据源无需鉴权。若未来切换到需 API Key 的服务，在此配置占位符，
# 并把请求头拼装逻辑加到 server/src/services/frankfurter.ts。
# 切勿提交真实密钥（.env 已在 .gitignore 中）。
# EXCHANGE_API_KEY=
